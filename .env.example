# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# "publishable" (anon) key — safe in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# "secret" (service role) key — SERVER ONLY, never ship to the client
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ---------- Database (Prisma) ----------
# App runtime: Supabase Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: direct connection (or Session pooler, port 5432)
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ---------- Cloudinary ----------
# from the Cloudinary dashboard "API Environment variable"
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloud_name>"
# unsigned preset for client-side uploads (create in Cloudinary settings)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="hentai_uploads"

# ---------- App ----------
# No trailing slash — it's concatenated with paths for canonical URLs / sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Management console (fully separate from the public Supabase auth) ----------
# The console lives at /console but 404s unless you arrive through the secret
# entry URL once per session:  https://<site>/console?k=<ADMIN_ENTRY_TOKEN>
ADMIN_ENTRY_TOKEN="generate-with-openssl-rand-hex-24"
# Signs the gate + pending-2FA cookies (any long random string). Falls back to
# STREAM_SECRET if unset.
ADMIN_GATE_SECRET="generate-with-openssl-rand-hex-32"
# One-time: needed only to create the FIRST admin account. Enter it on the
# console's first-run screen, then delete this var.
ADMIN_BOOTSTRAP_SECRET="generate-with-openssl-rand-hex-24"

# Google Analytics 4 — measurement id (looks like G-XXXXXXXXXX). Leave unset to
# disable analytics entirely (no script loads).
NEXT_PUBLIC_GA_ID=""

# MyAnimeList API
MAL_CLIENT_ID="your_mal_client_id"

# Cron
CRON_SECRET="generate-with-openssl-rand-hex-24"

# Signs the /api/stream tokens that hide real video-source URLs from the page.
# Any long random string. Falls back to CRON_SECRET/DIRECT_URL if unset, but set it.
STREAM_SECRET="generate-with-openssl-rand-hex-32"

# Optional: shared secret for the Bunny Stream status webhook. Set the same
# value here and as ?secret=<value> on the webhook URL in the Bunny dashboard.
BUNNY_WEBHOOK_SECRET=""

# Optional: raise the db() retry count for long-running scripts / cron
# (the request-path default of 5 keeps total wait under the serverless timeout).
# DB_RETRY_ATTEMPTS="12"

# Bunny Stream — video hosting (video.bunnycdn.com API + b-cdn.net delivery)
BUNNY_STREAM_LIBRARY_ID="000000"
BUNNY_STREAM_API_KEY="xxxxxxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxx-xxxx"
NEXT_PUBLIC_BUNNY_CDN_HOST="vz-xxxxxxxx-xxx.b-cdn.net"
